{
  "name": "clubhouse",
  "productName": "Clubhouse",
  "version": "0.6.0",
  "description": "Premium desktop golf intelligence platform",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Clubhouse",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/cutzbyheim-lab/Clubhouse.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/test.mjs run",
    "test:watch": "node scripts/test.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --publish never",
    "rebuild:native": "node scripts/install-native.mjs",
    "postinstall": "node scripts/install-native.mjs"
  },
  "build": {
    "appId": "com.clubhouse.desktop",
    "productName": "Clubhouse",
    "copyright": "Clubhouse",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Clubhouse-Setup-${version}.${ext}",
      "shortcutName": "Clubhouse"
    },
    "linux": {
      "target": "dir",
      "category": "Sports"
    },
    "publish": {
      "provider": "github",
      "owner": "cutzbyheim-lab",
      "repo": "Clubhouse",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "electron-updater": "^6.8.11",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "~42.11.18",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
